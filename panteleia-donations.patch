@@ -0,0 +1,123 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+type DonationCardProps = {
+  accountHolder: string;
+  iban: string;
+  bic: string;
+  bank: string;
+  branch: string;
+};
+
+async function copyText(value: string) {
+  if (navigator.clipboard?.writeText) {
+    await navigator.clipboard.writeText(value);
+    return;
+  }
+
+  const textarea = document.createElement("textarea");
+  textarea.value = value;
+  textarea.style.position = "fixed";
+  textarea.style.opacity = "0";
+  document.body.appendChild(textarea);
+  textarea.select();
+  document.execCommand("copy");
+  textarea.remove();
+}
+
+export function DonationCard({
+  accountHolder,
+  iban,
+  bic,
+  bank,
+  branch,
+}: DonationCardProps) {
+  const [copyStatus, setCopyStatus] = useState<"idle" | "copied" | "error">("idle");
+
+  useEffect(() => {
+    if (copyStatus === "idle") {
+      return;
+    }
+
+    const timeout = window.setTimeout(() => setCopyStatus("idle"), 2500);
+    return () => window.clearTimeout(timeout);
+  }, [copyStatus]);
+
+  async function handleCopy() {
+    try {
+      await copyText(iban);
+      setCopyStatus("copied");
+    } catch {
+      setCopyStatus("error");
+    }
+  }
+
+  const details = [
+    { label: "Intestatario", value: accountHolder },
+    { label: "BIC / SWIFT", value: bic },
+    { label: "Banca", value: bank },
+    { label: "Filiale", value: branch },
+  ];
+
+  return (
+    <article className="overflow-hidden rounded-[32px] border border-stone-200 bg-white shadow-[0_28px_80px_-52px_rgba(41,37,36,0.42)]">
+      <div className="border-b border-stone-200 bg-[linear-gradient(135deg,_#fffaf7_0%,_#f4e8df_100%)] p-6 sm:p-8">
+        <div className="flex items-start justify-between gap-5">
+          <div>
+            <p className="text-xs font-semibold uppercase tracking-[0.22em] text-[#aa2034]">
+              Bonifico bancario
+            </p>
+            <h2 className="mt-3 font-serif text-3xl text-stone-950 sm:text-4xl">
+              Donazione libera
+            </h2>
+          </div>
+          <div
+            aria-hidden="true"
+            className="flex size-12 shrink-0 items-center justify-center rounded-full bg-[#aa2034] text-white shadow-sm"
+          >
+            <svg viewBox="0 0 24 24" className="size-6" fill="none" stroke="currentColor">
+              <path
+                d="M12 21s-7-4.35-9.33-8.28C.62 9.27 2.27 5 6.15 5c2.05 0 3.22 1.17 3.85 2.17C10.63 6.17 11.8 5 13.85 5c3.88 0 5.53 4.27 3.48 7.72C15 16.65 12 21 12 21Z"
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                strokeWidth="1.7"
+              />
+            </svg>
+          </div>
+        </div>
+      </div>
+
+      <div className="p-6 sm:p-8">
+        <div className="rounded-2xl border border-[#aa2034]/15 bg-[#fffaf7] p-5 sm:p-6">
+          <p className="text-xs font-semibold uppercase tracking-[0.18em] text-stone-500">
+            IBAN
+          </p>
+          <p className="mt-3 break-all font-mono text-lg font-semibold tracking-[0.04em] text-stone-950 sm:text-xl">
+            {iban}
+          </p>
+          <button
+            type="button"
+            onClick={handleCopy}
+            className="btn mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[#aa2034] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#931a2c] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#aa2034]/40"
+          >
+            <svg viewBox="0 0 24 24" className="size-4" fill="none" stroke="currentColor">
+              <rect x="8" y="8" width="11" height="11" rx="2" strokeWidth="1.8" />
+              <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" strokeWidth="1.8" />
+            </svg>
+            {copyStatus === "copied" ? "IBAN copiato" : "Copia IBAN"}
+          </button>
+          <p className="sr-only" aria-live="polite">
+            {copyStatus === "copied"
+              ? "IBAN copiato negli appunti."
+              : copyStatus === "error"
+                ? "Non e' stato possibile copiare l'IBAN."
+                : ""}
+          </p>
+        </div>
+
+        <dl className="mt-7 grid gap-x-8 gap-y-5 sm:grid-cols-2">
+          {details.map((detail) => (
+            <div key={detail.label} className="border-b border-stone-100 pb-4">
+              <dt className="text-xs font-semibold uppercase tracking-[0.15em] text-stone-500">
+                {detail.label}
+              </dt>
+              <dd className="mt-2 text-base font-medium leading-7 text-stone-900">
+                {detail.value}
+              </dd>
+            </div>
+          ))}
+        </dl>
+      </div>
+    </article>
+  );
+}
